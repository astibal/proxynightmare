preamble
name "Encrypted TLS 1.3 marked stream"
description "Generated integrity stream is protected by negotiated TLS traffic keys"
timeout 15s
begin using tls
server at local
client at local
server listen "127.0.0.1:49304"
client connect "127.0.0.1:49304"
client hello
server hello
server change-cipher-spec
server encrypted-extensions
server certificate
server certificate-verify
server finished
client change-cipher-spec
client finished
server drain 128KiB stamp-every 2KiB
client transmit 128KiB stamp-every 2KiB chunk 333B
client await-tx
server await-rx
client close-notify
client write-eot
server receive-eot
server close
client close
end
outcome pass
when client.tls.handshake == complete
and server.tls.handshake == complete
and server.rx.bytes == 128KiB
and server.rx.integrity == valid
and server.tls.close-notify == received
describe "Real TLS 1.3 protected the complete marked stream."
outcome fail "TLS handshake, AEAD transport, or stream integrity validation failed."
outcome timeout "Encrypted TLS stream stalled."
end
