preamble
name "QUIC v1 encrypted stream torture"
description "Real QUIC/TLS 1.3 stream carries marked data and ends with STREAM FIN"
timeout 20s
begin using quic
server at local
client at local
server listen "127.0.0.1:49310"
client connect "127.0.0.1:49310"
client handshake
server drain 256KiB stamp-every 2KiB
client transmit 256KiB stamp-every 2KiB chunk 777B
client await-tx
client half-close-write
server await-rx
server receive-eot
server close
client close
end
outcome pass
when client.quic.handshake == complete
and server.quic.handshake == complete
and server.rx.bytes == 256KiB
and server.rx.integrity == valid
and server.rx.eot == received
describe "Real QUIC v1 delivered and concluded the complete encrypted stream."
outcome fail "QUIC handshake, stream encryption, integrity, or FIN validation failed."
outcome timeout "QUIC handshake or stream stalled."
end
