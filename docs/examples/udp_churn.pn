preamble
name "UDP source-port churn"
description "Three marked datagram streams survive two client socket rotations"
timeout 10s
begin using udp
server at local
client at local
server listen "127.0.0.1:49301"
client connect "127.0.0.1:49301"

server drain 32KiB stamp-every 1KiB
client transmit 32KiB stamp-every 1KiB chunk 1200B
client await-tx
server await-rx

server reconnect
client reconnect
server drain 32KiB stamp-every 1KiB
client transmit 32KiB stamp-every 1KiB chunk 511B
client await-tx
server await-rx

server reconnect
client reconnect
server drain 32KiB stamp-every 1KiB
client transmit 32KiB stamp-every 1KiB chunk 1379B
client await-tx
server await-rx

# These are deliberately legal no-ops in UDP mode.
client write-eot
server receive-eot
server close
client close
end
outcome pass
when server.rx.bytes == 32KiB
and server.rx.integrity == valid
describe "All UDP churn generations arrived without corruption."
outcome fail "A UDP generation was lost, reordered, truncated, or corrupted."
outcome timeout "UDP churn stalled."
end
