preamble
name "Real TLS 1.3 phase sequence"
description "Exercise proxy buffering across an OpenSSL-generated cryptographic handshake"
timeout 10s
begin using tls
server at local
client at local
server listen "127.0.0.1:49303"
client connect "127.0.0.1:49303"
client hello
server hello
server change-cipher-spec
server encrypted-extensions
server certificate
server certificate-verify
server finished
client change-cipher-spec
client finished
server new-session-ticket
server key-update
client key-update
client close-notify
client write-eot
server receive-eot
server close
client close
end
outcome pass
when server.tls.client-hello == received
and client.tls.server-hello == received
and client.tls.finished == received
and server.tls.finished == received
and client.tls.handshake == complete
and server.tls.handshake == complete
and server.tls.close-notify == received
describe "The cryptographic TLS 1.3 handshake and post-handshake phases completed."
outcome fail "A real TLS phase was missing, invalid, or reordered."
outcome timeout "Cryptographic TLS handshake stalled."
end
