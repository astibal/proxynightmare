preamble
name "Local PN smoke test"
description "Checks generated stream validation without SSH or a proxy"
timeout 5s
begin using tcp
server at local
client at local
server listen "127.0.0.1:39191"
client connect "127.0.0.1:39191"
server drain 64KiB stamp-every 1KiB
client transmit 64KiB stamp-every 1KiB chunk 257B
client await-tx
client half-close-write
server await-rx
server receive-eot
server close
client close
end
outcome pass
when server.rx.bytes == 64KiB
and server.rx.integrity == valid
and server.rx.eot == received
describe "Local stream arrived completely and without corruption."
outcome fail "Local generated stream validation failed."
outcome timeout "Local stream did not finish before timeout."
end
