preamble
name "Autonomous TLS 1.3 handshake"
description "Client and server drive OpenSSL concurrently"
timeout 10s
begin using tls
server at local
client at local
server listen "127.0.0.1:49305"
client connect "127.0.0.1:49305"
client handshake
client close-notify
client write-eot
server receive-eot
server close
client close
end
outcome pass
when client.tls.handshake == complete
and server.tls.handshake == complete
and server.tls.close-notify == received
and server.rx.eot == received
describe "Both autonomous TLS endpoints completed and closed cleanly."
outcome fail "Autonomous TLS handshake or shutdown failed."
outcome timeout "Autonomous TLS handshake stalled."
end
